{
  "name": "agnostic-engine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w agnostic-engine-renderer",
    "build": "npm run build -w agnostic-engine-renderer",
    "start": "npm run start -w agnostic-engine-renderer",
    "lint": "npm run lint -w agnostic-engine-renderer",
    "typecheck": "npm run typecheck -w agnostic-engine-renderer",
    "test": "npm run test -w agnostic-engine-renderer",
    "test:watch": "npm run test:watch -w agnostic-engine-renderer",
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm exec -w agnostic-engine-renderer eslint --fix",
      "npm exec -w agnostic-engine-renderer vitest run --related --passWithNoTests"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
